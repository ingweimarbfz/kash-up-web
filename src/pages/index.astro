---
import Base from '../layouts/Base.astro'
import PlanCards from '../components/PlanCards.astro'
import CountryPicker from '../components/CountryPicker.astro'
import { getCatalog, money } from '../lib/plans.js'
import { MODULES } from '../lib/modules.js'
import { BRAND, demoLink } from '../lib/config.js'

const cat = await getCatalog()
const country = cat.countries.find((c) => c.code === 'CO') || cat.countries[0]
const plans = cat.byCountry[country.code] || []
const FAQ = [
  ['¿Qué es QuontUp360?', 'Un software en la nube para negocios de préstamos y ventas a crédito: créditos con cuotas, cobro diario en ruta, cajas de los prestamistas, productos a crédito, flota de cobro y reportes.'],
  ['¿En qué países funciona?', `En ${cat.countries.map((c) => c.name).join(', ')}. Cada negocio trabaja en la moneda de su país y los planes tienen precio en esa moneda.`],
  ['¿El prestamista lo puede usar desde el celular?', 'Sí. El rutero, los pagos con recibo, los gastos y el cierre de jornada están pensados para el celular, con la ubicación de cada cobro.'],
  ['¿Cuántos prestamistas y clientes puedo tener?', 'Depende del plan: cada plan define cuántas sedes, administradores, prestamistas, conductores y clientes permite. Puedes cambiar de plan cuando crezcas.'],
  ['¿Mi información está separada de otros negocios?', 'Sí. Cada negocio tiene sus usuarios, sedes, clientes y dinero aislados de los demás.'],
  ['¿Hay periodo de prueba?', `Sí. Los planes incluyen ${plans[0]?.trialDays || 15} días de prueba para que lo uses con tu propia cartera.`]
]
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: BRAND, url: Astro.site.href, logo: new URL('/app-icon-512.png', Astro.site).href },
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: BRAND, applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Android, iOS',
    description: 'Software para negocios de préstamos: créditos con cuotas diarias, cobro en ruta, cajas, productos a crédito y reportes.',
    offers: plans.map((p) => ({ '@type': 'Offer', name: `Plan ${p.name}`, price: String(p.priceMonth), priceCurrency: p.currency, areaServed: country.name }))
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }
]
---
<Base title="QuontUp360: software para préstamos, cobro diario y ventas a crédito" description={`Programa para prestamistas y negocios de crédito: cuotas diarias, rutas de cobro desde el celular, cajas, inventario a crédito y reportes. Planes desde ${money(plans[0]?.priceMonth || 0, country)} al mes en Colombia y precios en la moneda de cada país.`} jsonLd={jsonLd} lang="es">
  <section class="hero">
    <div class="wrap hero-in">
      <div>
        <p class="kicker">Software para préstamos y ventas a crédito</p>
        <h1>Tu cartera bajo control, cuota a cuota</h1>
        <p class="lead">Presta en efectivo o en productos, organiza la ruta de cada cobrador, registra los pagos con recibo desde el celular y cuadra la caja al final del día. QuontUp360 funciona en {cat.countries.length} países de Latinoamérica, cada uno en su moneda.</p>
        <div class="cta">
          <a class="btn lg" href={demoLink()}>Pedir demostración</a>
          <a class="btn lg outline light" href="/precios">Ver precios en tu país</a>
        </div>
        <ul class="checks">
          <li>En la nube, sin instalar nada</li>
          <li>Hecho para el celular del cobrador</li>
          <li>Varias sedes y ciudades</li>
          <li>Precios en tu moneda</li>
        </ul>
      </div>
      <div class="hero-card" aria-hidden="true">
        <p class="hc-title">Ruta de hoy · Laura</p>
        <div class="hc-row"><span>1. Marta Gómez · cuota 12/30</span><b>Pagó</b></div>
        <div class="hc-row"><span>2. Tienda La Esquina · cuota 5/20</span><b>Pagó</b></div>
        <div class="hc-row bad"><span>3. Jorge Ríos · 2 cuotas atrasadas</span><b>Visitar</b></div>
        <div class="hc-row"><span>4. Ana Pardo · cuota 18/24</span><b>Pendiente</b></div>
        <div class="hc-total"><span>Recaudo del día</span><b>86 % de la meta</b></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Todo lo que necesita un negocio de crédito</h2>
      <p class="sec-lead">Desde que apruebas el préstamo hasta que se paga la última cuota.</p>
      <div class="cards">
        {MODULES.map((m) => (
          <a class="card" href={`/modulos#${m.key}`}>
            <span class="card-ico" aria-hidden="true">{m.icon}</span>
            <h3>{m.name}</h3>
            <p>{m.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec alt" id="planes">
    <div class="wrap">
      <h2>Planes y precios en {country.name}</h2>
      <p class="sec-lead">Precios en {country.currencyName} ({country.currency}). ¿Estás en otro país? Elige el tuyo:</p>
      <CountryPicker countries={cat.countries} current={country.code} />
      <PlanCards plans={plans} country={country} />
      <p class="center"><a href="/precios/colombia">Comparar todos los planes →</a></p>
    </div>
  </section>

  <section class="sec" id="preguntas">
    <div class="wrap narrow">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        {FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-in">
      <h2>¿Quieres verlo con los datos de tu negocio?</h2>
      <a class="btn lg" href={demoLink()}>Pedir demostración</a>
    </div>
  </section>
</Base>
